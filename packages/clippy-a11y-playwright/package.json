{
  "name": "@nl-design-system-community/clippy-a11y-playwright",
  "repository": {
    "type": "git",
    "url": "https://github.com/nl-design-system/editor.git",
    "directory": "packages/clippy-a11y-playwright"
  },
  "keywords": [
    "expertteam-digitale-toegankelijkheid",
    "nl-design-system",
    "accessibility",
    "playwright",
    "html-validation"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "pnpm run build:ts && pnpm run build:vite",
    "build:ts": "tsc --build",
    "build:vite": "vite build",
    "pretest": "pnpm --filter @nl-design-system-community/clippy-a11y-validator run build",
    "test": "playwright test"
  },
  "dependencies": {
    "@nl-design-system-community/clippy-a11y-validator": "workspace:*"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.50.0"
  },
  "devDependencies": {
    "@nl-design-system/tsconfig": "1.0.5",
    "@playwright/test": "1.61.1",
    "@types/node": "22.20.0",
    "typescript": "6.0.3",
    "vite": "8.1.3",
    "vite-plugin-dts": "5.0.3"
  }
}
