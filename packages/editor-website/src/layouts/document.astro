---
import SiteBreadcrumb from '../components/SiteBreadcrumb.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import type { Locale } from '../i18n/translations.ts';

interface Props {
  title?: string;
}
const { title = 'Rich-text Editor - NL Design System' } = Astro.props;
const locale = (Astro.currentLocale ?? 'nl') as Locale;
---

<html lang={locale} dir="ltr" class="ma-theme clippy-theme utrecht-root">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script>
      import {
        COLOR_SCHEME_STORAGE_KEY,
        DARK_COLOR_SCHEME_CLASS,
        DARK_COLOR_SCHEME_QUERY,
      } from '@nl-design-system-community/editor/color-scheme';

      try {
        const stored = localStorage.getItem(COLOR_SCHEME_STORAGE_KEY);
        const dark = stored === 'dark' || (stored === null && window.matchMedia(DARK_COLOR_SCHEME_QUERY).matches);
        document.documentElement.classList.toggle(DARK_COLOR_SCHEME_CLASS, dark);
      } catch (error) {
        /* localStorage/matchMedia unavailable — fall back to the default light theme. */
      }
    </script>
    <script>
      import '@fontsource/fira-sans/400.css';
      import '@fontsource/fira-sans/700.css';
      import '@fontsource/source-sans-pro/400.css';
      import '@fontsource/source-sans-pro/700.css';
      import '@nl-design-system-community/ma-design-tokens/dist/theme.css';
      import '@nl-design-system-community/ma-design-tokens/dist/color-scheme-dark/theme.css';
      import '@utrecht/design-tokens/dist/theme.css';
      import '@utrecht/component-library-css/dist/index.css';
      import '@nl-design-system-community/editor';
      import '@nl-design-system-community/editor/theme.css';
      import '@nl-design-system-candidate/button-css/button.css';
      import '@nl-design-system-candidate/heading-css/heading.css';
      import '@nl-design-system-candidate/paragraph-css/paragraph.css';
      import '@amsterdam/design-system-css/dist/breadcrumb/breadcrumb.css';
      import '@nl-design-system-community/clippy-components/clippy-card';
      import '@nl-design-system-community/clippy-components/clippy-card-as-link';
      import '@nl-design-system-community/clippy-components/clippy-layout';
      import '@nl-design-system-community/clippy-components/clippy-navigation-bar';
      import '@nl-design-system-community/clippy-components/clippy-page-header';
      import '@nl-design-system-community/clippy-components/clippy-page-layout';
      import '@nl-design-system-community/clippy-components/clippy-side-navigation';
    </script>
  </head>
  <body class="utrecht-body">
    <clippy-page-layout>
      <SiteHeader />
      <clippy-layout size="md" purpose="default">
        <SiteBreadcrumb />
        <slot />
      </clippy-layout>
      <SiteFooter />
    </clippy-page-layout>
  </body>
</html>

<style is:global>
  clippy-page-layout {
    --clippy-page-layout-background-color: var(--basis-color-accent-1-bg-subtle);
    grid-template-columns: minmax(0, 1fr);
  }

  main > .nl-heading {
    --nl-heading-level-1-margin-block-end: var(--basis-space-block-xl);
  }

  main > .nl-paragraph {
    --nl-paragraph-margin-block-end: var(--basis-space-block-xl);
  }

  .ma-page-section {
    display: flex;
    flex-direction: column;
    row-gap: var(--basis-space-inline-lg);
  }

  .ma-page-section--with-space {
    margin-block: var(--basis-space-block-4xl);
  }

  .clippy-guideline {
    --utrecht-space-around: 0;
    --utrecht-code-font-size: var(--basis-text-font-size-md);
    border: 1px solid var(--basis-color-default-border-default);
    margin-block-end: var(--basis-space-block-4xl);
    margin-block-start: 0;
    margin-inline-end: 0;
    margin-inline-start: 0;
    background-color: var(--basis-color-default-bg-document);
  }

  .clippy-guideline:first-of-type {
    margin-block-start: var(--basis-space-block-3xl);
  }

  p + .clippy-guideline {
    margin-block-start: var(--basis-space-block-3xl);
  }

  .clippy-guideline + .clippy-guideline {
    margin-block-start: var(--basis-space-block-3xl);
  }

  .clippy-guideline__description {
    padding-block: var(--basis-space-block-3xl);
    padding-inline: var(--basis-space-inline-3xl);
  }

  .clippy-guideline__example {
    border-block-end-width: 0;
    border-block-start-width: 1px;
    border-color: var(--basis-color-default-border-default);
    border-inline-width: 0;
    border-style: solid;
    padding-block: var(--basis-space-block-xl);
    padding-inline: var(--basis-space-inline-xl);
  }

  .clippy-guideline select {
    display: block;
    margin-bottom: 0.5em;
  }

  .clippy-guideline__title {
    vertical-align: middle;
  }

  .clippy-guideline__badge {
    --utrecht-paragraph-font-weight: bold;
    font-size: var(--basis-text-font-size-lg);
    margin-block-end: var(--basis-space-block-xl);
    margin-block-start: 0;
    display: flex;
    gap: var(--basis-space-block-md);
    align-items: center;
  }

  .clippy-guideline__badge--negative {
    --utrecht-paragraph-color: currentColor;
    color: var(--basis-color-negative-color-default);
  }

  .clippy-guideline--negative {
    --nlds-canvas-code-block-cursor: not-allowed;
    --nlds-canvas-code-block-user-select: none;
    --nlds-canvas-toolbar-copy-display: none;
  }

  .clippy-guideline__example [contenteditable] {
    border-block-end: 1px solid transparent;
    border-block-start: 1px solid transparent;
    padding-inline: var(--basis-space-inline-md);
  }

  /* Make room for the absolutely-positioned gutter (1rem wide) that lives
     inside clippy-content in the guidelines canvas examples. */
  .clippy-canvas clippy-content {
    padding-inline-end: 1rem;
  }

  .clippy-guideline__validations {
    border-block-start: 1px solid var(--basis-color-default-border-default);
    padding-block: var(--basis-space-inline-md);
    padding-inline: var(--basis-space-inline-md);
  }

  clippy-editor,
  .clippy-guideline {
    box-shadow: var(--basis-box-shadow-md);
  }

  .clippy-toolbar-config-demo {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-block-end: 1rem;
  }
</style>
