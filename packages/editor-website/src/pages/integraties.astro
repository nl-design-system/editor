---
import ckeditorLogo from '../assets/logos/ckeditor.svg?raw';
import drupalLogo from '../assets/logos/drupal.svg?raw';
import typo3Logo from '../assets/logos/typo3.svg?raw';
import Document from '../layouts/document.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import CardGroup from '../components/CardGroup.astro';
import PackageLinks from '../components/PackageLinks.astro';
import ckeditorPackage from '../../../ckeditor-plugin/package.json';
import drupalPackage from '../../../drupal-ckeditor-plugin/package.json';
import typo3Package from '../../../typo3-ckeditor-plugin/package.json';
import { frontmatter as indexFrontmatter } from '../../../../docs/index.md';
import { useTranslations } from '../i18n/translations.ts';

const t = useTranslations('nl');
---

<Document title={t('integrations.title')}>
  <main>
    <h1 class="nl-heading nl-heading--level-1">{indexFrontmatter['title']}</h1>
    <p class="nl-paragraph">{indexFrontmatter['intro']}</p>

    <Section>
      <CardGroup>
        <Card heading="Drupal" logo={drupalLogo} id="drupal">
          <p>
            Integreer Clippy in Drupal door de <code>ClippyPlugin</code> toe te voegen aan de CKEditor-configuratie. Zo zijn
            de toegankelijkheidsvalidaties direct beschikbaar voor redacteurs.
          </p>
          <PackageLinks pkg={drupalPackage} />
        </Card>

        <Card heading="CKEditor" logo={ckeditorLogo} href="/ckeditor" footer="Bekijk de CKEditor-plugin demo">
          <p>
            Clippy Editor biedt een CKEditor 5-plugin waarmee je de toegankelijkheidsvalidaties van Clippy kunt
            toevoegen aan elke CKEditor-instantie.
          </p>
          <PackageLinks pkg={ckeditorPackage} />
        </Card>

        <Card heading="TYPO3" logo={typo3Logo} id="typo3">
          <p>
            Installeer de Clippy-extensie in TYPO3. Clippy wordt dan toegevoegd aan elke rich-text editor, welke preset
            die ook gebruikt, zodat de toegankelijkheidsvalidaties direct beschikbaar zijn voor redacteuren.
          </p>
          <p>Npm-pakket: <code>@nl-design-system-community/typo3-ckeditor-plugin</code></p>
          <PackageLinks npm={false} pkg={typo3Package} />
        </Card>
      </CardGroup>
    </Section>
  </main>
</Document>
