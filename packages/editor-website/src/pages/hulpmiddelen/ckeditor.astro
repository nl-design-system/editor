---
import Document from '../../layouts/document.astro';
import SectionNavigation from '../../components/SectionNavigation.astro';
import Section from '../../components/Section.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import PackageLinks from '../../components/PackageLinks.astro';
import CKEditorDemo from '../../components/CKEditorDemo.astro';
import ckeditorPackage from '@nl-design-system-community/ckeditor-plugin/package.json';
import { useTranslations } from '../../i18n/translations.ts';

const t = useTranslations('nl');

const usage = `import { ClassicEditor, Essentials, Heading, Image, ImageTextAlternative, ImageToolbar, Paragraph } from 'ckeditor5';
import { ClippyAltTextWizard, ClippyPlugin } from '${ckeditorPackage.name}';
import 'ckeditor5/ckeditor5.css';

await ClassicEditor.create(document.querySelector('#editor'), {
  licenseKey: 'GPL',
  plugins: [Essentials, Heading, Paragraph, Image, ImageTextAlternative, ImageToolbar, ClippyPlugin, ClippyAltTextWizard],
  toolbar: ['heading'],
  image: { toolbar: ['imageTextAlternative'] },
});`;
---

<Document title={t('library.ckeditor.title')}>
  <SectionNavigation href={t('nav.href.libraries')} />
  <main>
    <h1 class="nl-heading nl-heading--level-1">CKEditor-plugin</h1>
    <p class="nl-paragraph">
      Met de CKEditor-plugin voeg je Clippy Editor toe aan elke CKEditor 5 editor, ook buiten Drupal en TYPO3.
      Redacteuren krijgen dan meldingen terwijl ze schrijven, met uitleg over hoe ze een probleem oplossen. Gebruik je
      Drupal of TYPO3? Dan is de plugin al onderdeel van{' '}
      <a class="nl-link" href={t('nav.href.library.drupal')}>
        Clippy Editor voor Drupal
      </a>{' '}
      en{' '}
      <a class="nl-link" href={t('nav.href.library.typo3')}>
        Clippy Editor voor TYPO3
      </a>
      .
    </p>
    <PackageLinks pkg={ckeditorPackage} />

    <Section>
      <h2 class="nl-heading nl-heading--level-2">Installeren</h2>
      <p class="nl-paragraph">De plugin werkt met CKEditor 5 versie 43 of nieuwer.</p>
      <CodeBlock code={`npm install ckeditor5 ${ckeditorPackage.name}`} />
    </Section>

    <Section>
      <h2 class="nl-heading nl-heading--level-2">Gebruiken</h2>
      <p class="nl-paragraph">Het pakket bevat twee CKEditor-plugins:</p>
      <ul>
        <li>
          <code>ClippyPlugin</code> toont de toegankelijkheidsmeldingen in de editor.
        </li>
        <li>
          <code>ClippyAltTextWizard</code> voegt de alt-tekst wizard toe aan het venster voor de alt-tekst van een
          afbeelding. Daarvoor heeft de editor ook <code>Image</code> en <code>ImageTextAlternative</code> nodig.
        </li>
      </ul>
      <p class="nl-paragraph">Voeg ze toe aan de plugins van je editor:</p>
      <CodeBlock code={usage} />
    </Section>

    <Section>
      <h2 class="nl-heading nl-heading--level-2">Demo</h2>
      <p class="nl-paragraph">
        In deze CKEditor staat een tekst met toegankelijkheidsproblemen. Pas de tekst aan en bekijk welke meldingen
        Clippy Editor geeft.
      </p>
      <CKEditorDemo locale="nl" />
    </Section>
  </main>
</Document>
