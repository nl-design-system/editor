---
import Document from '../../layouts/document.astro';
import SectionNavigation from '../../components/SectionNavigation.astro';
import Section from '../../components/Section.astro';
import PackageLinks from '../../components/PackageLinks.astro';
import drupalPackage from '@nl-design-system-community/drupal-ckeditor-plugin/package.json';
import { useTranslations } from '../../i18n/translations.ts';

const t = useTranslations('nl');
---

<Document title={t('library.drupal.title')}>
  <SectionNavigation href={t('nav.href.libraries')} />
  <main>
    <h1 class="nl-heading nl-heading--level-1">Drupal</h1>
    <p class="nl-paragraph">
      Installeer de Clippy-module in Drupal. De module voegt Clippy toe aan CKEditor 5, zodat de
      toegankelijkheidsvalidaties direct beschikbaar zijn voor redacteuren.
    </p>
    <PackageLinks pkg={drupalPackage} />

    <Section>
      <h2 class="nl-heading nl-heading--level-2">Wat de module toevoegt</h2>
      <ul>
        <li>Toegankelijkheidsmeldingen in de editor.</li>
        <li>Een knop voor de alt-tekst wizard bij afbeeldingen, in tekstformaten met de afbeeldingsplugin.</li>
        <li>
          <em>Page review</em>: een knop op pagina's in het frontend-thema die de toegankelijkheidsmeldingen van de hele
          pagina toont, voor gebruikers met de permissie <em>Use Page review</em>.
        </li>
      </ul>
    </Section>

    <Section>
      <h2 class="nl-heading nl-heading--level-2">Instellingen</h2>
      <p class="nl-paragraph">
        Ga naar <em>Configuration → Content authoring → Clippy</em>. Daar zet je Clippy in CKEditor en{' '}
        <em>Page review</em> aan of uit, en kies je welk deel van de pagina <em>Page review</em> controleert.
      </p>
    </Section>
  </main>
</Document>
