---
import Document from '../../layouts/document.astro';
import ValidationsTable from '../../components/ValidationsTable.astro';
import SectionNavigation from '../../components/SectionNavigation.astro';
import Section from '../../components/Section.astro';
import { frontmatter as guidelinesFrontmatter } from '../../../../../docs/guidelines.md';
import { useTranslations } from '../../i18n/translations.ts';

const t = useTranslations('nl');
---

<Document title={t('guidelines.title')}>
  <SectionNavigation href={t('nav.href.guidelines')} />
  <main>
    <h1 class="nl-heading nl-heading--level-1">{guidelinesFrontmatter['title']}</h1>
    <p class="nl-paragraph">{guidelinesFrontmatter['intro']}</p>

    <Section>
      <h2 class="nl-heading nl-heading--level-2">Alle validaties</h2>
      <p class="nl-paragraph">
        De toegankelijkheidsvalidator controleert de inhoud met deze regels. Kies een validatie voor een voorbeeld en de
        richtlijn op NL Design System.
      </p>
      <ValidationsTable />
    </Section>

    <Section>
      <h2 class="nl-heading nl-heading--level-2">Een validatie toevoegen</h2>
      <p class="nl-paragraph">
        Mis je een controle, of klopt een melding niet? Maak een <a
          class="nl-link"
          href="https://github.com/nl-design-system/editor/issues">issue</a
        > aan op GitHub. Elke regel staat in een eigen map in
        <a
          class="nl-link"
          href="https://github.com/nl-design-system/editor/tree/main/packages/clippy-a11y-validator/src/components"
          ><code>clippy-a11y-validator/src/components</code></a
        >. In de <a
          class="nl-link"
          href="https://github.com/nl-design-system/editor/tree/main/packages/clippy-a11y-validator#writing-your-own-validation"
          >README</a
        > lees je hoe je een validatie schrijft. Op de <a class="nl-link" href={t('nav.href.community')}>community</a
        >-pagina staat hoe je bijdraagt.
      </p>
    </Section>
  </main>
</Document>
