---
import Document from '../../layouts/document.astro';
import LibrariesNavigation from '../../components/LibrariesNavigation.astro';
import Section from '../../components/Section.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import PackageLinks from '../../components/PackageLinks.astro';
import typo3Package from '../../../../typo3-ckeditor-plugin/package.json';
import { useTranslations } from '../../i18n/translations.ts';

const t = useTranslations('nl');
---

<Document title={t('library.typo3.title')}>
  <LibrariesNavigation />
  <main>
    <h1 class="nl-heading nl-heading--level-1">TYPO3</h1>
    <p class="nl-paragraph">
      Installeer de Clippy-extensie in TYPO3. Clippy wordt dan toegevoegd aan elke rich-text editor, welke preset die
      ook gebruikt, zodat de toegankelijkheidsvalidaties direct beschikbaar zijn voor redacteuren.
    </p>
    <PackageLinks pkg={typo3Package} />

    <Section>
      <h2 class="nl-heading nl-heading--level-2">Clippy uitzetten</h2>
      <p class="nl-paragraph">
        Clippy staat aan zodra de extensie is geïnstalleerd. Zet Clippy voor de hele installatie uit met <em
          >Add Clippy to every rich text editor</em
        > onder <em>Admin Tools → Settings → Extension Configuration → clippy</em>.
      </p>
      <p class="nl-paragraph">Laat Clippy weg uit één preset door de module in die preset te verwijderen:</p>
      <CodeBlock
        code={`editor:\n  config:\n    removeImportModules:\n      - '@nl-design-system-community/clippy/clippy.js'`}
      />
    </Section>
  </main>
</Document>
