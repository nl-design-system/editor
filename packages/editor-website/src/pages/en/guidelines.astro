---
import Document from '../../layouts/document.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import { frontmatter as guidelinesFrontmatter } from '../../../../../docs/en/guidelines.md';
import { useTranslations } from '../../i18n/translations.ts';
import iconMoodSad from '@tabler/icons/outline/mood-sad.svg?raw';

const t = useTranslations('en');
---

<Document title={t('guidelines.title')}>
  <main>
    <Hero title={guidelinesFrontmatter['title']} intro={guidelinesFrontmatter['intro']} />

    <Section>
      <clippy-context id="editor-1">
        <div slot="value">
          <p>Hi,</p>
          <p>&nbsp;</p>
          <p>Kind regards,</p>
          <p>Robbert</p>
        </div>
        <div class="clippy-guideline clippy-guideline--negative">
          <div class="clippy-guideline__description">
            <h2 class="clippy-guideline__badge clippy-guideline__badge--negative">
              <Fragment set:html={iconMoodSad} />
              <span class="clippy-guideline__title">Don't: empty paragraph</span>
            </h2>
            <p>Do not use empty paragraphs to create spacing.</p>
          </div>
          <div class="clippy-guideline__example">
            <div class="clippy-canvas">
              <div class="clippy-canvas__example">
                <clippy-content>
                  <clippy-validations-gutter mode="list"></clippy-validations-gutter>
                </clippy-content>
              </div>
            </div>
          </div>
          <div class="clippy-guideline__validations">
            <clippy-validations-list></clippy-validations-list>
          </div>
        </div>
      </clippy-context>

      <clippy-context id="editor-2">
        <div slot="value">
          <h2>Bold</h2>
          <p>Empty Bold: <b>&nbsp;</b></p>
          <p>Bold with text: <b>text</b></p>
          <h2>Link</h2>
          <p>Empty Link: <a href="#">&nbsp;</a></p>
          <p>Link with text: <a href="#">text</a></p>
          <h2>Underline</h2>
          <p>Empty Underline: <u>&nbsp;</u></p>
          <p>Underline with text: <u>text</u></p>
          <h2>Strong</h2>
          <p>Empty Strong: <strong>&nbsp;</strong></p>
          <p>Strong with text: <strong>text</strong></p>
          <h2>Mark</h2>
          <p>Empty Mark: <mark>&nbsp;</mark></p>
          <p>Mark with text: <mark>text</mark></p>
          <h2>Emphasis</h2>
          <p>Empty Emphasis: <em>&nbsp;</em></p>
          <p>Emphasis with text: <em>text</em></p>
          <h2>Strikethrough</h2>
          <p>Empty Strikethrough: <s>&nbsp;</s></p>
          <p>Strikethrough with text: <s>text</s></p>
          <h2>Italic</h2>
          <p>Empty Italic: <i>&nbsp;</i></p>
          <p>Italic with text: <i>text</i></p>
        </div>
        <div class="clippy-guideline clippy-guideline--negative">
          <div class="clippy-guideline__description">
            <h2 class="clippy-guideline__badge clippy-guideline__badge--negative">
              <Fragment set:html={iconMoodSad} />
              <span class="clippy-guideline__title">Don't: empty inline elements</span>
            </h2>
            <p>Clean up empty elements.</p>
          </div>
          <div class="clippy-guideline__example">
            <div class="clippy-canvas">
              <div class="clippy-canvas__example">
                <clippy-content>
                  <clippy-toolbar config='[["bold","italic","code"],["link","image-upload","insert-table"]]'
