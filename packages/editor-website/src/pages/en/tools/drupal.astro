---
import Document from '../../../layouts/document.astro';
import SectionNavigation from '../../../components/SectionNavigation.astro';
import Section from '../../../components/Section.astro';
import PackageLinks from '../../../components/PackageLinks.astro';
import drupalPackage from '@nl-design-system-community/drupal-ckeditor-plugin/package.json';
import { useTranslations } from '../../../i18n/translations.ts';

const t = useTranslations('en');
---

<Document title={t('library.drupal.title')}>
  <SectionNavigation href={t('nav.href.libraries')} />
  <main>
    <h1 class="nl-heading nl-heading--level-1">Drupal</h1>
    <p class="nl-paragraph">
      Install the Clippy Editor module in Drupal. The module adds Clippy Editor to CKEditor 5, so the accessibility
      validations are immediately available to editors.
    </p>
    <PackageLinks pkg={drupalPackage} />

    <Section>
      <h2 class="nl-heading nl-heading--level-2">What the module adds</h2>
      <ul>
        <li>Accessibility feedback in the editor.</li>
        <li>An alt-text wizard button for images, in text formats with the image plugin.</li>
        <li>
          <em>Page review</em>: a button on pages in the frontend theme that shows the accessibility issues of the whole
          page, for users with the <em>Use Page review</em> permission.
        </li>
      </ul>
    </Section>

    <Section>
      <h2 class="nl-heading nl-heading--level-2">Settings</h2>
      <p class="nl-paragraph">
        Go to <em>Configuration → Content authoring → Clippy</em> to turn Clippy Editor in CKEditor and{' '}
        <em>Page review</em> on or off, and to choose which part of the page <em>Page review</em> validates.
      </p>
    </Section>
  </main>
</Document>
