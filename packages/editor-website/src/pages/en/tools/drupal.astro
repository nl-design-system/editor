---
import Document from '../../../layouts/document.astro';
import SectionNavigation from '../../../components/SectionNavigation.astro';
import Section from '../../../components/Section.astro';
import PackageLinks from '../../../components/PackageLinks.astro';
import drupalPackage from '@nl-design-system-community/drupal-ckeditor-plugin/package.json';
import { useTranslations } from '../../../i18n/translations.ts';

const t = useTranslations('en');
---

<Document title={t('library.drupal.title')}>
  <SectionNavigation href={t('nav.href.libraries')} />
  <main>
    <h1 class="nl-heading nl-heading--level-1">Clippy Editor for Drupal</h1>
    <p class="nl-paragraph">
      Clippy Editor for Drupal is a module that helps editors create accessible content: while writing in CKEditor 5,
      and on the page itself with Page review. The{' '}
      <a class="nl-link" href={t('nav.href.integrations')}>
        integrations
      </a>{' '}
      page explains how the two work together.
    </p>
    <PackageLinks pkg={drupalPackage} />

    <Section>
      <h2 class="nl-heading nl-heading--level-2">What editors get</h2>
      <ul>
        <li>Notifications in CKEditor while they write, explaining how to fix each problem.</li>
        <li>An alt-text wizard for images, in text formats that allow images.</li>
        <li>
          Page review: a button that lets an editor check the whole page, with overviews of the headings, the links and
          the language changes on the page.
        </li>
        <li>An editor that follows the light or dark mode of the admin theme.</li>
      </ul>
    </Section>

    <Section>
      <h2 class="nl-heading nl-heading--level-2">What you need</h2>
      <p class="nl-paragraph">Drupal 11.1 or later, with CKEditor 5.</p>
    </Section>

    <Section>
      <h2 class="nl-heading nl-heading--level-2">Who sees Page review</h2>
      <p class="nl-paragraph">
        Only users with the <em>Use Page review</em> permission see Page review, and only on pages in the website's
        theme. On installation, the <em>Content editor</em> role gets that permission, if the role exists. Visitors of
        the website do not see Page review.
      </p>
      <p class="nl-paragraph">
        The button sits in the admin bar your website already uses. On a page without an admin bar, the button sits in a
        corner of the page.
      </p>
    </Section>

    <Section>
      <h2 class="nl-heading nl-heading--level-2">What you can configure</h2>
      <p class="nl-paragraph">
        Under <em>Configuration → Content authoring → Clippy Editor</em> you set:
      </p>
      <ul>
        <li>whether Clippy Editor is on in CKEditor;</li>
        <li>whether Page review is on, for everyone at once;</li>
        <li>
          which part of the page Page review checks (the <code>&lt;main&gt;</code> element by default);
        </li>
        <li>
          which parts Page review leaves out (by default the links Drupal adds to blocks, such as
          <em>Configure block</em>);
        </li>
        <li>whether the markers in the gutter show straight away, or only while Page review is open;</li>
        <li>which corner the button sits in on pages without an admin bar.</li>
      </ul>
    </Section>

    <Section>
      <h2 class="nl-heading nl-heading--level-2">Installing</h2>
      <p class="nl-paragraph">
        Download the archive from the latest release, unpack it into your website's modules and enable the module under{' '}
        <em>Extend</em>. The archive contains a manual with every step.
      </p>
    </Section>
  </main>
</Document>
