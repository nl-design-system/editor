---
import Document from '../../../../layouts/document.astro';
import SectionNavigation from '../../../../components/SectionNavigation.astro';
import Section from '../../../../components/Section.astro';
import CodeBlock from '../../../../components/CodeBlock.astro';
import PackageLinks from '../../../../components/PackageLinks.astro';
import editorPackage from '../../../../../../editor/package.json';
import reactPackage from '../../../../../../react/package.json';
import { useTranslations } from '../../../../i18n/translations.ts';

const t = useTranslations('en');
---

<Document title={t('library.editor.title')}>
  <SectionNavigation href={t('nav.href.libraries')} />
  <main>
    <h1 class="nl-heading nl-heading--level-1">Editor</h1>
    <p class="nl-paragraph">
      The accessible rich-text editor as Web Components. It works in any framework and checks content while editors
      write.
    </p>
    <PackageLinks pkg={editorPackage} />

    <Section>
      <h2 class="nl-heading nl-heading--level-2">Installation</h2>
      <CodeBlock code={`npm install ${editorPackage.name}`} />
    </Section>

    <Section>
      <h2 class="nl-heading nl-heading--level-2" id="components">Usage</h2>
      <p class="nl-paragraph">Import the Web Components and the theme:</p>
      <CodeBlock code={`import '${editorPackage.name}';\nimport '${editorPackage.name}/theme.css';`} />
      <p class="nl-paragraph">Place the editor on the page. The initial value goes in the <code>value</code> slot:</p>
      <CodeBlock
        code={`<clippy-editor>\n  <div slot="value">\n    <p>Content here...</p>\n  </div>\n</clippy-editor>`}
      />
      <p class="nl-paragraph">
        Set up the toolbar in the <a class="nl-link" href={t('nav.href.configuration')}>configuration</a>.
      </p>
    </Section>

    <Section>
      <h2 class="nl-heading nl-heading--level-2">React</h2>
      <p class="nl-paragraph">
        Using React? The Web Components are also available as React components. See the
        <a class="nl-link" href={t('nav.href.react')}>React examples</a>.
      </p>
      <CodeBlock code={`npm install ${reactPackage.name}`} />
      <PackageLinks pkg={reactPackage} />
    </Section>
  </main>
</Document>
