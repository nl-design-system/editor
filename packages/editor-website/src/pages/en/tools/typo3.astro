---
import Document from '../../../layouts/document.astro';
import SectionNavigation from '../../../components/SectionNavigation.astro';
import Section from '../../../components/Section.astro';
import CodeBlock from '../../../components/CodeBlock.astro';
import PackageLinks from '../../../components/PackageLinks.astro';
import typo3Package from '@nl-design-system-community/typo3-ckeditor-plugin/package.json';
import { useTranslations } from '../../../i18n/translations.ts';

const t = useTranslations('en');
---

<Document title={t('library.typo3.title')}>
  <SectionNavigation href={t('nav.href.libraries')} />
  <main>
    <h1 class="nl-heading nl-heading--level-1">Clippy Editor for TYPO3</h1>
    <p class="nl-paragraph">
      Clippy Editor for TYPO3 is an extension that adds Clippy Editor to every rich-text editor, whatever preset it
      uses, so the accessibility validations are immediately available to editors.
    </p>
    <PackageLinks pkg={typo3Package} />

    <Section>
      <h2 class="nl-heading nl-heading--level-2">Switching Clippy Editor off</h2>
      <p class="nl-paragraph">
        Clippy Editor is on as soon as the extension is installed. To switch it off for the whole installation, clear{' '}
        <em>Add Clippy Editor to every rich text editor</em> under{' '}
        <em>Admin Tools → Settings → Extension Configuration → clippy</em>.
      </p>
      <p class="nl-paragraph">To leave Clippy Editor out of a single preset, remove its module in that preset:</p>
      <CodeBlock
        code={`editor:\n  config:\n    removeImportModules:\n      - '@nl-design-system-community/clippy/clippy.js'`}
      />
    </Section>

    <Section>
      <h2 class="nl-heading nl-heading--level-2">Page review</h2>
      <p class="nl-paragraph">
        Backend users who are logged in see a <em>Page review</em> button on frontend pages, which shows the
        accessibility issues of the whole page. To switch it off, clear <em>Show Page review on frontend pages</em>{' '}
        under <em>Admin Tools → Settings → Extension Configuration → clippy</em>.
      </p>
    </Section>
  </main>
</Document>
