---
import Document from '../../layouts/document.astro';
import ValidationCard from '../../components/ValidationCard.astro';
import Section from '../../components/Section.astro';
import { frontmatter as indexFrontmatter } from '../../../../../docs/en/index.md';
import { useTranslations } from '../../i18n/translations.ts';

const t = useTranslations('en');
---

<Document title={t('index.title')}>
  <main>
    <h1 class="nl-heading nl-heading--level-1">{indexFrontmatter['title']}</h1>
    <p class="nl-paragraph">{indexFrontmatter['intro']}</p>
    <div class="utrecht-action-group">
      <a
        class="nl-button nl-button--primary"
        href="https://github.com/nl-design-system/editor"
        target="_blank"
        rel="noreferrer"
      >
        <span class="nl-button__label">{t('index.cta.github')}</span>
      </a>
      <a
        class="nl-button nl-button--secondary"
        href="https://github.com/orgs/nl-design-system/projects/70/views/27"
        target="_blank"
        rel="noreferrer"
      >
        <span class="nl-button__label">{t('index.cta.roadmap')}</span>
      </a>
    </div>

    <Section>
      <h2 class="nl-heading nl-heading--level-2">What is Clippy Editor?</h2>
      <p class="nl-paragraph">
        Clippy Editor helps editors of Dutch government websites create accessible content. It works in two places:
        while writing in the rich-text editor, and on the published page with Page review. Both use the same
        validations, based on the NL Design System guidelines.
      </p>
      <p class="nl-paragraph">
        Clippy Editor works in CKEditor, Drupal and TYPO3, and also has its own rich-text editor as Web Components. The{' '}
        <a class="nl-link" href={t('nav.href.integrations')}>
          integrations
        </a>{' '}
        page explains which part fits your website or CMS.
      </p>
    </Section>

    <Section>
      <h2 class="nl-heading nl-heading--level-2">What problem does Clippy Editor solve?</h2>
      <p class="nl-paragraph">
        Many accessibility problems are introduced while writing: a skipped heading level, an image without alt text, a
        link that says "click here" or empty paragraphs used for spacing. An automated test only finds these issues once
        the page is already online.
      </p>
      <p class="nl-paragraph">
        Clippy Editor points these problems out to editors while they write. Every notification explains what is wrong
        and how to fix it. This helps you meet WCAG 2.2 level AA and ATAG 2.0.
      </p>
    </Section>

    <Section>
      <h2 class="nl-heading nl-heading--level-2">How it works</h2>
      <p class="nl-paragraph">
        In this example, heading level 3 follows heading level 1 directly. Clippy Editor marks the heading in the gutter
        and explains the issue below the text.
      </p>
      <ValidationCard headingLevel={3} rule="HEADING_LEVEL_MUST_NOT_SKIP" />
      <p class="nl-paragraph">
        You can find more examples in the{' '}
        <a class="nl-link" href={t('nav.href.guidelines')}>
          validations
        </a>
        .
      </p>
    </Section>

    <Section>
      <h2 class="nl-heading nl-heading--level-2">Using Clippy Editor</h2>
      <ul>
        <li>
          Try the full editor in the{' '}
          <a class="nl-link" href={t('nav.href.demo')}>
            demo
          </a>
          .
        </li>
        <li>
          See every package in the{' '}
          <a class="nl-link" href={t('nav.href.libraries')}>
            tools
          </a>
          .
        </li>
      </ul>
    </Section>
  </main>
</Document>

<script>
  import '../../scripts/guideline-validations.ts';
</script>
