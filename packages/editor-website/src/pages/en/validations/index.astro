---
import Document from '../../../layouts/document.astro';
import SectionNavigation from '../../../components/SectionNavigation.astro';
import Section from '../../../components/Section.astro';
import { frontmatter as guidelinesFrontmatter } from '../../../../../../docs/en/guidelines.md';
import { useTranslations } from '../../../i18n/translations.ts';
import { validationGroups } from '../../../utils/validationGroups.ts';

const t = useTranslations('en');
---

<Document title={t('guidelines.title')}>
  <SectionNavigation href={t('nav.href.guidelines')} />
  <main>
    <h1 class="nl-heading nl-heading--level-1">{guidelinesFrontmatter['title']}</h1>
    <p class="nl-paragraph">{guidelinesFrontmatter['intro']}</p>

    <Section>
      <h2 class="nl-heading nl-heading--level-2">Validations per component</h2>
      <p class="nl-paragraph">
        The validations follow the components of NL Design System. Each component has its own page with the rules the
        validator checks, each with an example.
      </p>
      <ul class="utrecht-unordered-list">
        {
          validationGroups.map(({ label, slug }) => (
            <li class="utrecht-unordered-list__item">
              <a class="nl-link" href={`${t('nav.href.guidelines')}/${slug.en}`}>
                {label.en}
              </a>
            </li>
          ))
        }
      </ul>
    </Section>

    <Section>
      <h2 class="nl-heading nl-heading--level-2">Adding a validation</h2>
      <p class="nl-paragraph">
        Missing a check, or is a message wrong? Open an <a
          class="nl-link"
          href="https://github.com/nl-design-system/editor/issues">issue</a
        > on GitHub. Each rule lives in its own folder in
        <a
          class="nl-link"
          href="https://github.com/nl-design-system/editor/tree/main/packages/clippy-a11y-validator/src/components"
          ><code>clippy-a11y-validator/src/components</code></a
        >. The <a
          class="nl-link"
          href="https://github.com/nl-design-system/editor/tree/main/packages/clippy-a11y-validator#writing-your-own-validation"
          >README</a
        > explains how to write a validation. The <a class="nl-link" href={t('nav.href.community')}>community</a> page explains
        how to contribute.
      </p>
    </Section>
  </main>
</Document>
