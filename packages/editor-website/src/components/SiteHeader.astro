---
import iconMoonOutline from '@tabler/icons/outline/moon.svg?raw';
import iconMoonFilled from '@tabler/icons/filled/moon.svg?raw';
import SiteLogo from './SiteLogo.astro';
import SiteNavigation from './SiteNavigation.astro';
import type { Locale } from '../i18n/translations.ts';
import { useTranslations } from '../i18n/translations.ts';

const locale = (Astro.currentLocale ?? 'nl') as Locale;
const t = useTranslations(locale);
const otherLocale = locale === 'en' ? 'nl' : 'en';
---

<clippy-page-header slot="header" variant="compact" label-drawer-title={t('nav.label')}>
  <div slot="logo">
    <SiteLogo href={t('nav.href.editor')} ariaLabel={t('site.logo.label')} />
  </div>
  <SiteNavigation placement="navigation-bar" />
  <SiteNavigation placement="navigation-drawer" />
  <clippy-button slot="end" id="ma-color-scheme-toggle" class="ma-theme-toggle" purpose="secondary" toggle icon-only>
    <span
      slot="iconStart"
      class="ma-theme-toggle__icon ma-theme-toggle__icon--outline"
      aria-hidden="true"
      set:html={iconMoonOutline}
    />
    <span
      slot="iconStart"
      class="ma-theme-toggle__icon ma-theme-toggle__icon--filled"
      aria-hidden="true"
      set:html={iconMoonFilled}
    />
    {t('theme.toggle')}
  </clippy-button>
  <a
    slot="end"
    class="nl-button nl-button--subtle ma-language-link"
    href={t('nav.href.language')}
    hreflang={otherLocale}
    lang={otherLocale}
  >
    <span class="nl-button__label">{t('nav.language')}</span>
  </a>
</clippy-page-header>

<script>
  import type { ClippyButton } from '@nl-design-system-community/clippy-components/clippy-button';
  import {
    applyColorScheme,
    isDarkColorScheme,
    setDarkColorScheme,
    storeColorScheme,
  } from '@nl-design-system-community/editor/color-scheme';

  const toggle = document.querySelector<ClippyButton>('#ma-color-scheme-toggle');

  applyColorScheme((colorScheme) => {
    if (toggle) {
      toggle.pressed = colorScheme === 'dark';
    }
  });

  toggle?.addEventListener('click', () => {
    const dark = !isDarkColorScheme();
    setDarkColorScheme(dark);
    storeColorScheme(dark ? 'dark' : 'light');
  });
</script>

<style>
  .ma-theme-toggle {
    --nl-button-secondary-background-color: transparent;
    --nl-button-secondary-color: currentColor;
    --nl-button-secondary-border-color: currentColor;
    --nl-button-secondary-hover-background-color: var(--basis-color-accent-1-inverse-bg-hover);
    --nl-button-secondary-hover-color: currentColor;
    --nl-button-secondary-hover-border-color: currentColor;
    --nl-button-secondary-active-background-color: var(--basis-color-accent-1-inverse-bg-active);
    --nl-button-secondary-active-color: currentColor;
    --nl-button-secondary-active-border-color: currentColor;
    --nl-button-secondary-pressed-background-color: var(--basis-color-accent-1-inverse-bg-active);
    --nl-button-secondary-pressed-color: currentColor;
    --nl-button-secondary-pressed-border-color: currentColor;
    --nl-button-secondary-pressed-hover-background-color: var(--basis-color-accent-1-inverse-bg-hover);
    --nl-button-secondary-pressed-hover-color: currentColor;
    --nl-button-secondary-pressed-hover-border-color: currentColor;
  }

  .ma-theme-toggle__icon--filled {
    display: none;
  }

  :global(.ma-theme--color-scheme-dark) .ma-theme-toggle__icon--outline {
    display: none;
  }

  :global(.ma-theme--color-scheme-dark) .ma-theme-toggle__icon--filled {
    display: inline-flex;
  }

  .ma-language-link {
    color: var(--basis-color-accent-1-inverse-color-default);
    text-decoration: none;
  }

  .ma-language-link:hover {
    background-color: var(--basis-color-accent-1-inverse-bg-hover);
    color: var(--basis-color-accent-1-inverse-color-hover);
  }

  .ma-language-link:active {
    background-color: var(--basis-color-accent-1-inverse-bg-active);
    color: var(--basis-color-accent-1-inverse-color-active);
  }
</style>
