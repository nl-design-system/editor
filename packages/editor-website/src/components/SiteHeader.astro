---
import iconMoonOutline from '@tabler/icons/outline/moon.svg?raw';
import iconMoonFilled from '@tabler/icons/filled/moon.svg?raw';
import SiteLogo from './SiteLogo.astro';
import type { Locale } from '../i18n/translations.ts';
import { useTranslations } from '../i18n/translations.ts';

const locale = (Astro.currentLocale ?? 'nl') as Locale;
const t = useTranslations(locale);

const navItems = [
  { href: t('nav.href.editor'), label: t('nav.editor') },
  { href: t('nav.href.configuration'), label: t('nav.configuration') },
  { href: t('nav.href.guidelines'), label: t('nav.guidelines') },
  { href: t('nav.href.react'), label: t('nav.react') },
  { href: t('nav.href.integrations'), label: t('nav.integrations') },
  { href: t('nav.href.alt-text-wizard'), label: t('nav.alt-text-wizard') },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

// Determine the root path for "active" check per locale
const localeRoot = locale === 'en' ? '/en' : '/';
---

<header class="ma-site-header">
  <div class="ma-site-header__logo">
    <SiteLogo href={t('nav.href.editor')} ariaLabel={t('site.logo.label')} />
  </div>
  <nav class="ma-site-header__nav" aria-label={t('nav.label')}>
    <ul class="ma-site-header__nav-list" role="list">
      {
        navItems.map(({ href, label }) => {
          const isActive = href === localeRoot ? currentPath === localeRoot : currentPath.startsWith(href);
          return (
            <li>
              <a
                class={`ma-site-header__nav-link${isActive ? ' ma-site-header__nav-link--active' : ''}`}
                href={href}
                aria-current={isActive ? 'page' : undefined}
              >
                {label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
  <div class="ma-site-header__actions">
    <button
      type="button"
      id="ma-color-scheme-toggle"
      class="nl-button nl-button--secondary nl-button--icon-only"
      aria-pressed="false"
    >
      <span
        class="nl-button__icon-start ma-theme-toggle__icon ma-theme-toggle__icon--outline"
        aria-hidden="true"
        set:html={iconMoonOutline}
      />
      <span
        class="nl-button__icon-start ma-theme-toggle__icon ma-theme-toggle__icon--filled"
        aria-hidden="true"
        set:html={iconMoonFilled}
      />
      <span class="nl-button__label">{t('theme.toggle')}</span>
    </button>
    <nav class="ma-site-header__lang-nav" aria-label={t('nav.language.label')}>
      <a class="ma-site-header__lang-link" href={t('nav.href.language')} hreflang={locale === 'en' ? 'nl' : 'en'}>
        {t('nav.language')}
      </a>
    </nav>
  </div>
</header>

<script>
  const STORAGE_KEY = 'ma-color-scheme';
  const DARK_CLASS = 'ma-theme--color-scheme-dark';

  const root = document.documentElement;
  const toggle = document.getElementById('ma-color-scheme-toggle');
  const media = window.matchMedia('(prefers-color-scheme: dark)');

  const isDark = () => root.classList.contains(DARK_CLASS);
  const syncState = () => {
    toggle?.setAttribute('aria-pressed', String(isDark()));
    toggle?.classList.toggle('nl-button--pressed', isDark());
  };

  // The pre-paint inline script has already set the class; reflect it on the button.
  syncState();

  toggle?.addEventListener('click', () => {
    const next = !isDark();
    root.classList.toggle(DARK_CLASS, next);
    localStorage.setItem(STORAGE_KEY, next ? 'dark' : 'light');
    syncState();
  });

  // Follow the system preference only while the user hasn't made an explicit choice.
  media.addEventListener('change', (event) => {
    if (localStorage.getItem(STORAGE_KEY) === null) {
      root.classList.toggle(DARK_CLASS, event.matches);
      syncState();
    }
  });
</script>

<style>
  .ma-site-header {
    /* Use the inverse-bg/inverse-color pair so the bar stays a dark accent surface
       with legible light text in both the light and dark color schemes. */
    background-color: var(--basis-color-accent-1-inverse-bg-default);
    color: var(--basis-color-accent-1-inverse-color-document);
    align-items: stretch;
    justify-content: space-between;
    display: flex;
    gap: var(--basis-space-inline-xl);
  }

  .ma-site-header__logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    padding-block: var(--basis-space-block-lg);
    padding-inline: var(--basis-space-inline-lg);
  }

  .ma-site-header__nav {
    display: flex;
    align-self: stretch;
    align-items: stretch;
  }

  .ma-site-header__nav-list {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ma-site-header__nav-link {
    font-weight: var(--basis-text-font-weight-bold);
    box-sizing: border-box;
    display: flex;
    align-items: center;
    padding-block: var(--basis-space-block-md);
    padding-inline: var(--basis-space-inline-xl);
    block-size: 100%;
    color: inherit;
    font-size: var(--basis-text-font-size-md);
    text-decoration: none;
  }

  .ma-site-header__nav-link:hover {
    background-color: var(--basis-color-accent-1-inverse-bg-hover);
  }

  .ma-site-header__nav-link--active {
    background-color: var(--basis-color-accent-1-inverse-bg-active);
    border-block-end: var(--basis-border-width-md) solid var(--basis-color-default-inverse-border-default);
  }

  .ma-site-header__actions {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: var(--basis-space-inline-lg);
    padding-inline: var(--basis-space-inline-xl);
  }

  /* The outlined button sits on the accent header, so inherit its inverse
     colour to keep the outline and icon visible against the dark background. */
  #ma-color-scheme-toggle {
    background-color: transparent;
    border-color: currentColor;
    color: inherit;
  }

  /* Show the outline moon in light mode and the filled moon in dark mode.
     Keyed off the root scheme class, which the pre-paint script sets, so the
     correct icon is shown on first paint without a flash. */
  .ma-theme-toggle__icon--filled {
    display: none;
  }

  :global(.ma-theme--color-scheme-dark) .ma-theme-toggle__icon--outline {
    display: none;
  }

  :global(.ma-theme--color-scheme-dark) .ma-theme-toggle__icon--filled {
    display: inline-flex;
  }

  #ma-color-scheme-toggle:hover {
    background-color: var(--basis-color-accent-1-inverse-bg-hover);
    border-color: currentColor;
    color: inherit;
  }

  #ma-color-scheme-toggle.nl-button--pressed {
    background-color: var(--basis-color-accent-1-inverse-bg-active);
    border-color: currentColor;
    color: inherit;
  }

  .ma-site-header__lang-nav {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    padding-block: var(--basis-space-block-md);
  }

  .ma-site-header__lang-link {
    color: inherit;
    font-size: var(--basis-text-font-size-md);
    text-decoration: none;
  }

  .ma-site-header__lang-link:hover {
    text-decoration: underline;
  }
</style>
