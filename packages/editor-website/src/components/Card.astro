---
interface Props {
  heading: string;
  href?: string;
  id?: string;
  logo?: string;
}

const { heading, href, id, logo } = Astro.props;
---

{
  href ? (
    <clippy-card-as-link class="clippy-card" variant="list-item" id={id}>
      {logo && <span slot="pre-header" class="clippy-card__logo" aria-hidden="true" set:html={logo} />}
      <h2 slot="header" class="clippy-card__heading">
        {heading}
      </h2>
      <a slot="link" href={href}>
        {heading}
      </a>
      <div slot="body" class="clippy-card__content">
        <slot />
      </div>
    </clippy-card-as-link>
  ) : (
    <clippy-card class="clippy-card" id={id}>
      {logo && <span slot="pre-header" class="clippy-card__logo" aria-hidden="true" set:html={logo} />}
      <h2 slot="header" class="clippy-card__heading">
        {heading}
      </h2>
      <div slot="body" class="clippy-card__content">
        <slot />
      </div>
    </clippy-card>
  )
}

<style is:global>
  .clippy-card {
    --clippy-card-background-color: var(--basis-color-default-bg-default);
    --clippy-card-border-color: var(--basis-color-default-border-subtle);
    --clippy-card-border-radius: var(--basis-border-radius-md);
    --clippy-card-color: var(--basis-color-default-color-document);
    --clippy-card-header-text-decoration: none;
    column-gap: var(--basis-space-inline-3xl);
    padding-block: var(--basis-space-block-3xl);
    padding-inline: var(--basis-space-inline-3xl);
    row-gap: var(--basis-space-block-xl);
  }

  clippy-card.clippy-card {
    align-content: start;
    display: grid;
    grid-template-columns: 1fr auto;
  }

  .clippy-card::part(header-body) {
    row-gap: var(--basis-space-block-xl);
  }

  .clippy-card::part(pre-header) {
    grid-column: 2;
    grid-row: 1 / span 2;
    order: 1;
  }

  .clippy-card__logo {
    display: flex;
    inline-size: 6rem;
  }

  .clippy-card__heading {
    font-family: var(--basis-heading-font-family);
    font-size: var(--basis-text-font-size-2xl);
    font-weight: var(--basis-text-font-weight-bold);
    margin-block: 0;
  }

  .clippy-card__content {
    display: flex;
    flex-direction: column;
    row-gap: var(--basis-space-row-md);
  }

  .clippy-card__content p {
    margin-block: 0;
  }

  @media (width < 48rem) {
    clippy-card-as-link.clippy-card {
      flex-direction: column;
      align-items: stretch;
    }

    clippy-card.clippy-card {
      grid-template-columns: 1fr;
    }

    .clippy-card::part(pre-header) {
      grid-column: auto;
      grid-row: auto;
      order: -1;
    }

    .clippy-card__logo {
      inline-size: 4rem;
    }
  }
</style>
