---
interface Props {
  heading: string;
  href?: string;
  id?: string;
}

const { heading, href, id } = Astro.props;
---

{
  href ? (
    <clippy-card-as-link class="clippy-card" variant="list-item" id={id}>
      <h2 slot="header" class="clippy-card__heading">
        {heading}
      </h2>
      <a slot="link" href={href}>
        {heading}
      </a>
      <div slot="body" class="clippy-card__content">
        <slot />
      </div>
    </clippy-card-as-link>
  ) : (
    <clippy-card class="clippy-card" id={id}>
      <h2 slot="header" class="clippy-card__heading">
        {heading}
      </h2>
      <div slot="body" class="clippy-card__content">
        <slot />
      </div>
    </clippy-card>
  )
}

<style is:global>
  .clippy-card {
    --clippy-card-background-color: transparent;
    --clippy-card-border-color: transparent;
    --clippy-card-border-radius: var(--basis-border-radius-md);
    --clippy-card-color: var(--basis-color-default-color-default);
    box-shadow: var(--basis-box-shadow-md);
    padding-block: var(--basis-space-block-xl);
    padding-inline: var(--basis-space-inline-xl);
    row-gap: var(--basis-space-row-lg);
  }

  .clippy-card::part(header-body) {
    row-gap: var(--basis-space-row-lg);
  }

  clippy-card-as-link.clippy-card:hover {
    box-shadow: var(--basis-box-shadow-lg);
  }

  .clippy-card__heading {
    font-size: var(--basis-text-font-size-xl);
    font-weight: var(--basis-text-font-weight-bold);
    margin-block: 0;
  }

  clippy-card-as-link .clippy-card__heading {
    color: var(--basis-color-action-1-color-default);
  }

  clippy-card-as-link:active .clippy-card__heading {
    color: var(--basis-color-action-1-color-active);
  }

  .clippy-card__content {
    display: flex;
    flex-direction: column;
    row-gap: var(--basis-space-row-md);
  }

  .clippy-card__content :global(p) {
    margin-block: 0;
  }
</style>
