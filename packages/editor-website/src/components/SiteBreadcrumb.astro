---
import type { Locale } from '../i18n/translations.ts';
import { useTranslations } from '../i18n/translations.ts';
import { getNavigationItems, type NavigationItem } from '../utils/getNavigationItems.ts';

const locale = (Astro.currentLocale ?? 'nl') as Locale;
const t = useTranslations(locale);
const [home, ...pages] = getNavigationItems(locale, Astro.url.pathname);

const findTrail = (items: NavigationItem[]): NavigationItem[] => {
  for (const item of items) {
    const childTrail = item.items ? findTrail(item.items) : [];
    if (childTrail.length) return [item, ...childTrail];
    if (item.current) return [item];
  }
  return [];
};

const trail = findTrail(pages);
const current = trail.at(-1);
---

{
  current && (
    <nav slot="breadcrumb" class="ams-breadcrumb" aria-label={t('breadcrumb.label')}>
      <ol class="ams-breadcrumb__list">
        {[home, ...trail.slice(0, -1)].map(({ href, label }) => (
          <li class="ams-breadcrumb__item">
            <a class="ams-breadcrumb__link" href={href}>
              {label}
            </a>
          </li>
        ))}
        <li class="ams-breadcrumb__item">
          <span aria-current="page">{current.label}</span>
        </li>
      </ol>
    </nav>
  )
}
