---
import type { Locale } from '../i18n/translations.ts';
import { useTranslations } from '../i18n/translations.ts';
import { getNavigationItems, type NavigationItem } from '../utils/getNavigationItems.ts';

const locale = (Astro.currentLocale ?? 'nl') as Locale;
const t = useTranslations(locale);
const currentPath = Astro.url.pathname.replace(/\/$/, '');
const libraries = getNavigationItems(locale, Astro.url.pathname).find(({ href }) => href === t('nav.href.libraries'));

const markCurrentPage = ({ href, items, label }: NavigationItem): NavigationItem => ({
  current: href === currentPath,
  href,
  label,
  ...(items && { items: items.map(markCurrentPage) }),
});
---

{
  libraries && (
    <clippy-side-navigation
      slot="sidebar"
      label={t('nav.side.label')}
      items={JSON.stringify([markCurrentPage(libraries)])}
    />
  )
}
