---
import type { Locale } from '../i18n/translations.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div id="ck-editor" data-locale={locale}></div>

<script>
  import 'ckeditor5/ckeditor5.css';
  import {
    ClassicEditor,
    Bold,
    Essentials,
    Heading,
    Image,
    ImageTextAlternative,
    ImageToolbar,
    ImageUpload,
    Italic,
    Link,
    List,
    Paragraph,
    Underline,
  } from 'ckeditor5';
  import coreTranslations from 'ckeditor5/translations/nl.js';
  import { ClippyAltTextWizard, ClippyPlugin } from '@nl-design-system-community/ckeditor-plugin';

  const content = {
    en: {
      headings: ['Paragraph', 'Heading 1', 'Heading 2', 'Heading 3', 'Heading 4', 'Heading 5', 'Heading 6'],
      initialData: `
        <h1>Example page</h1>
        <h1>A second heading 1</h1>
        <p>
          The city lies on a river that it could use like <strong>two arms</strong>, to reach the lake on one side
          and the sea on the other. It took advantage of this <i>favourable</i> location early on, to trade with
          the regions around those inland waters.
        </p>
        <h2>Heading 2</h2>
        <p></p>
        <h4>A heading 4 directly after a heading 2</h4>
        <p>
          You can read more about the city's history on
          <a href="https://example.com">its website</a>, or follow a link<a href="https://example.com"> </a>
          without any text.
        </p>
        <table>
          <tbody>
            <tr>
              <th>Name</th>
              <th colspan="3">Description</th>
            </tr>
            <tr>
              <td>Row 1, cell 1</td>
              <td>Row 1, cell 2</td>
              <td>Row 1, cell 3</td>
              <td>Row 1, cell 4</td>
            </tr>
          </tbody>
        </table>
        <dl>
          <dt>Term</dt>
          <dd>The meaning of the term</dd>
          <dt>Another term</dt>
          <dd>The meaning of another term</dd>
        </dl>
        <h2>Images</h2>
        <img src="https://placehold.co/800x400" />
        <h3>Correct list</h3>
        <ul>
          <li>Item</li>
          <li>Item</li>
          <li>Item</li>
        </ul>
        <h3>Incorrect numbered list</h3>
        <p>1 - Item<br />2 - Item<br />3 - Item</p>
      `,
    },
    nl: {
      headings: ['Alinea', 'Kop 1', 'Kop 2', 'Kop 3', 'Kop 4', 'Kop 5', 'Kop 6'],
      initialData: `
        <h1>Voorbeeldpagina</h1>
        <h1>Een tweede kop 1</h1>
        <p>
          Onder die steden, <strong>welke</strong> <i>vanouds</i> aan de <strong><i>grafelijke</i></strong> kroon
          van Holland gelijk zoovele edelgesteenten flonkerden, en wier macht en rijkdom tot een hechten steun
          verstrekten aan des Landsheer gezag, was Haarlem, gelijk genoeg bekend is, een der voornaamste.
        </p>
        <h2>Kop 2</h2>
        <p></p>
        <h4>Een kop 4 direct na een kop 2</h4>
        <p>
          Aan den over eener rivier gebouwd, waarvan zij zich als van
          <a href="https://example.com">twee armen bedienen</a> kon, om, aan de eene zijde, het Haarlemmermeer en de
          daarom gelegen landen, aan de andere hij IJ, en door het IJ, de Zuiderzee te bereiken, had zij van deze
          gunstige ligging reeds vroeg partij getrokken, om een<a href="https://example.com"> </a>handel te drijven,
          die, schoon zich zelden verder uitstrekkende dan de gewesten, welke om die binnenzeeën gelegen waren, haar
          niettemin gelegenheid gaf.
        </p>
        <table>
          <tbody>
            <tr>
              <th>Naam</th>
              <th colspan="3">Beschrijving</th>
            </tr>
            <tr>
              <td>Rij 1, cel 1</td>
              <td>Rij 1, cel 2</td>
              <td>Rij 1, cel 3</td>
              <td>Rij 1, cel 4</td>
            </tr>
          </tbody>
        </table>
        <dl>
          <dt>Term</dt>
          <dd>De betekenis van de term</dd>
          <dt>Nog een term</dt>
          <dd>De betekenis van nog een term</dd>
        </dl>
        <h2>Afbeeldingen</h2>
        <img src="https://placehold.co/800x400" />
        <h3>Correcte lijst</h3>
        <ul>
          <li>Test</li>
          <li>Test</li>
          <li>Test</li>
        </ul>
        <h3>Incorrect genummerde lijst</h3>
        <p>1 - Test<br />2 - Test<br />3 - Test</p>
      `,
    },
  };

  const editorEl = document.querySelector<HTMLElement>('#ck-editor');

  if (!editorEl) {
    throw new Error('Missing editor element');
  }

  const locale = editorEl.dataset['locale'] === 'en' ? 'en' : 'nl';
  const { headings, initialData } = content[locale];

  await ClassicEditor.create(editorEl, {
    plugins: [
      Essentials,
      Heading,
      Paragraph,
      Bold,
      Italic,
      Underline,
      Link,
      List,
      Image,
      ImageTextAlternative,
      ImageToolbar,
      ImageUpload,
      ClippyPlugin,
      ClippyAltTextWizard,
    ],
    toolbar: [
      'heading',
      '|',
      'bold',
      'italic',
      'underline',
      'link',
      '|',
      'bulletedList',
      'numberedList',
      '|',
      'insertImage',
    ],
    image: {
      toolbar: ['imageTextAlternative'],
    },
    heading: {
      options: [
        { model: 'paragraph', title: headings[0], class: 'ck-heading_paragraph' },
        { model: 'heading1', view: 'h1', title: headings[1], class: 'ck-heading_heading1' },
        { model: 'heading2', view: 'h2', title: headings[2], class: 'ck-heading_heading2' },
        { model: 'heading3', view: 'h3', title: headings[3], class: 'ck-heading_heading3' },
        { model: 'heading4', view: 'h4', title: headings[4], class: 'ck-heading_heading4' },
        { model: 'heading5', view: 'h5', title: headings[5], class: 'ck-heading_heading5' },
        { model: 'heading6', view: 'h6', title: headings[6], class: 'ck-heading_heading6' },
      ],
    },
    language: locale,
    translations: locale === 'nl' ? [coreTranslations] : [],
    licenseKey: 'GPL',
    initialData,
  });
</script>

<style is:global>
  :root.ma-theme--color-scheme-dark {
    --ck-color-base-background: var(--basis-color-default-bg-document);
    --ck-color-base-foreground: var(--basis-color-default-bg-default);
    --ck-color-base-border: var(--basis-color-default-border-subtle);
    --ck-color-base-text: var(--basis-color-default-color-document);
    --ck-color-base-error: var(--basis-color-negative-color-default);
    --ck-color-button-default-hover-background: var(--basis-color-default-bg-hover);
    --ck-color-button-default-active-background: var(--basis-color-default-bg-active);
    --ck-color-button-on-background: var(--basis-color-selected-bg-default);
    --ck-color-button-on-hover-background: var(--basis-color-selected-bg-hover);
    --ck-color-button-on-active-background: var(--basis-color-selected-bg-active);
    --ck-color-button-on-disabled-background: var(--basis-color-disabled-bg-default);
    --ck-color-button-on-color: var(--basis-color-selected-color-document);
    --ck-color-list-button-on-background: var(--basis-color-selected-bg-active);
    --ck-color-list-button-on-background-focus: var(--basis-color-selected-bg-hover);
    --ck-color-list-button-on-text: var(--basis-color-selected-color-document);
    --ck-color-dialog-background: var(--basis-color-default-bg-document);
    --ck-color-dialog-form-header-border: var(--basis-color-default-border-subtle);
    --ck-color-input-disabled-background: var(--basis-color-disabled-bg-default);
    --ck-color-input-disabled-border: var(--basis-color-disabled-border-default);
    --ck-color-input-disabled-text: var(--basis-color-disabled-color-default);
    --ck-color-engine-placeholder-text: var(--basis-color-default-color-subtle);
    --ck-color-tooltip-background: var(--basis-color-default-inverse-bg-document);
    --ck-color-tooltip-text: var(--basis-color-default-inverse-color-document);
  }

  :root.ma-theme--color-scheme-dark .ck.ck-editor__editable {
    color: var(--basis-color-default-color-document);
  }

  :root.ma-theme--color-scheme-dark .ck.ck-editor__editable a {
    color: var(--basis-color-info-color-default);
  }
</style>
